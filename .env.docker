# ============================================
# RBM - Docker Environment (VPS Production)
# ============================================
# File ini digunakan oleh docker-compose.yml di VPS
# ============================================

APP_NAME=RBM
APP_ENV=production
APP_KEY=base64:+TOmCCLJ7Gnt70RBcuOtNcm1zDa5XG2Bt9sPD+XqN2Q=
APP_DEBUG=false
APP_URL=http://localhost:8020
APP_TIMEZONE=Asia/Jakarta

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ---- Database ----
# Mengarah ke service rbm-db di docker-compose
DB_CONNECTION=mysql
DB_HOST=rbm-db
DB_PORT=3306
DB_DATABASE=rbm
DB_USERNAME=Yop1
DB_PASSWORD=dockerrbm

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=database
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

FCM_PROJECT_ID=yoyoycell-app

# ---- Port Configuration ----
# Port yang digunakan nginx rbm (diubah jika bentrok)
RBM_PORT=8020

# Port external MariaDB (untuk akses dari luar)
DB_EXTERNAL_PORT=3308

# Port untuk akses phpMyAdmin
PMA_PORT=8082

# Root password MariaDB
DB_ROOT_PASSWORD=dockerrbm

# Port untuk n8n
N8N_PORT=5678
N8N_HOST=n8n.yoyoycell.my.id
N8N_PROTOCOL=http

# Cloudflare Tunnel Token (Dapatkan dari Cloudflare Zero Trust Dashboard)
TUNNEL_TOKEN=
